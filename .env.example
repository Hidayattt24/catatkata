# ==============================================================================
# CATATKATA UNIFIED FULLSTACK ENVIRONMENT VARIABLES (Next.js + Supabase)
# ==============================================================================

# --- 1. Client-Side Variables (Browser UI & Auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=/api/v1

# --- 2. Server-Side Variables (Route Handlers & Database Access) ---
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=postgres://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
