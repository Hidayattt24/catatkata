{
  "name": "catatkata-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"web,api\" -c \"cyan.bold,green.bold\" \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "cd apps/api && go run ./cmd/server",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "cd apps/api && go build -o bin/server ./cmd/server",
    "lint:web": "npm run lint --workspace=apps/web"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
